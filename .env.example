# Jeton du bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Identifiant de l'application (Discord Developer Portal > General Information)
CLIENT_ID=

# Optionnel : identifiant d'un serveur de développement.
# Si renseigné, les commandes slash sont enregistrées uniquement sur ce serveur
# (mise à jour instantanée). Sinon, enregistrement global (propagation ~1 h).
GUILD_ID=

# Préfixe des commandes textuelles (défaut : !)
PREFIX=!

# Langue des messages (défaut : fr)
LOCALE=fr

# Optionnel : identifiant du salon de logs de modération.
# À défaut, le bot cherche un salon nommé "mod-logs".
MODLOG_CHANNEL_ID=

# Nom du rôle utilisé par la commande mute (défaut : Muted)
MUTED_ROLE_NAME=Muted

# Identifiant Discord de l'owner principal du bot.
# Tous les privilèges owner ; non supprimable via les commandes.
OWNER_ID=

# Nom du rôle décoratif attribué aux owners (défaut : Owner NaoBot)
OWNER_ROLE_NAME=Owner NaoBot
