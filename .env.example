# ============================================================
# Le .env ne contient QUE des données statiques et globales.
# Ne JAMAIS y stocker de configuration par serveur (salons,
# rôles, options activables, paramètres utilisateurs) : tout
# cela est persisté par serveur dans database/data/ via les
# commandes du bot (logs, bump, etc.).
# ============================================================

# Jeton du bot (Discord Developer Portal > Bot > Token) — obligatoire
BOT_TOKEN=

# Identifiant Discord de l'owner principal du bot.
# Tous les privilèges owner ; non supprimable via les commandes.
OWNER_ID=

# Identifiant du serveur privé recevant les logs d'erreurs internes du bot.
# Au démarrage, une catégorie et un salon #bot-errors y sont créés
# automatiquement. Aucun autre serveur n'a accès à ces logs.
ERROR_GUILD_ID=

# --- Optionnel : données statiques globales ---

# Identifiant de l'application (utilisé pour le lien d'invitation du bot)
CLIENT_ID=

# Serveur de développement : si renseigné, les commandes slash sont
# enregistrées uniquement sur ce serveur (mise à jour instantanée).
# Sinon, enregistrement global (propagation ~1 h).
GUILD_ID=

# Préfixe des commandes textuelles (défaut : !)
PREFIX=!

# Langue des messages (défaut : fr)
LOCALE=fr

# Nom du rôle utilisé par la commande mute (défaut : Muted)
MUTED_ROLE_NAME=Muted

# Nom du rôle décoratif attribué aux owners (défaut : Owner NaoBot)
OWNER_ROLE_NAME=Owner NaoBot

# Contact affiché aux serveurs bannis pour un éventuel recours
# (ex. : lien d'un serveur de support)
SUPPORT_CONTACT=

# --- Interface web (tableau de bord) + authentification Discord OAuth2 ---
# Statique, optionnel. Désactivée par défaut : ne démarre que si WEB_ENABLED
# est vrai ET que l'OAuth2 (DISCORD_CLIENT_ID + DISCORD_CLIENT_SECRET) et le
# secret de session sont renseignés. Aucune configuration dynamique de serveur
# ne vit ici.

# Active l'interface web (true/false)
WEB_ENABLED=false

# Port d'écoute du serveur web (défaut : 3000)
WEB_PORT=3000

# URL publique de base du site
WEB_URL=http://localhost:3000

# --- OAuth2 Discord (Developer Portal > OAuth2) ---
# Identifiant de l'application (OAuth2 > Client information).
# À défaut, CLIENT_ID (ci-dessus) est réutilisé.
DISCORD_CLIENT_ID=

# Secret client OAuth2 (OAuth2 > Client Secret)
DISCORD_CLIENT_SECRET=

# URI de redirection OAuth2. DOIT être déclarée à l'identique dans le portail
# Discord (OAuth2 > Redirects). À défaut : <WEB_URL>/callback
DISCORD_REDIRECT_URI=http://localhost:3000/callback

# Secret de signature des sessions web (chaîne aléatoire longue)
WEB_SESSION_SECRET=
