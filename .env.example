# ============================================================
# Le .env ne contient QUE des données statiques et globales.
# Ne JAMAIS y stocker de configuration par serveur (salons,
# rôles, options activables, paramètres utilisateurs) : tout
# cela est persisté par serveur dans database/data/ via les
# commandes du bot (logs, bump, etc.).
# ============================================================

# Jeton du bot (Discord Developer Portal > Bot > Token) — obligatoire
BOT_TOKEN=

# Identifiant Discord de l'owner principal du bot.
# Tous les privilèges owner ; non supprimable via les commandes.
OWNER_ID=

# --- Optionnel : données statiques globales ---

# Identifiant de l'application (utilisé pour le lien d'invitation du bot)
CLIENT_ID=

# Serveur de développement : si renseigné, les commandes slash sont
# enregistrées uniquement sur ce serveur (mise à jour instantanée).
# Sinon, enregistrement global (propagation ~1 h).
GUILD_ID=

# Préfixe des commandes textuelles (défaut : !)
PREFIX=!

# Langue des messages (défaut : fr)
LOCALE=fr

# Nom du rôle utilisé par la commande mute (défaut : Muted)
MUTED_ROLE_NAME=Muted

# Nom du rôle décoratif attribué aux owners (défaut : Owner NaoBot)
OWNER_ROLE_NAME=Owner NaoBot
